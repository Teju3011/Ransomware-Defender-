
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Refined recursive rule for all user-specific data (settings, reports, scans, privacy)
    // Separating the owner check from the admin existence check ensures that collection 'list' queries
    // can be statically verified for the owner without failing on the external admin lookup.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
      allow read, write: if isAdmin();
    }
  }
}
